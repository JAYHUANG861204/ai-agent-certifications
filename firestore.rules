rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 證照與分類資料：任何人都能讀（網頁本身不需要登入就能瀏覽），
    // 只有登入的使用者能寫（目前只有「同步資料到資料庫」按鈕會寫）。
    match /certifications/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 白名單設定：網頁需要讀它來檢查誰能登入看內容，所以公開可讀。
    // 不開放任何用戶端寫入 — 只能透過 Firebase Console 的 Firestore 資料頁簽手動編輯
    // （Console 用管理員權限操作，不受這條規則限制，所以這樣設定不會讓你自己也編輯不了）。
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
